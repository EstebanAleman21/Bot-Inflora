# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Token used during Meta webhook verification handshake
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Permanent access token from Meta developer console (System User token recommended)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxx

# The Phone Number ID of your WhatsApp Business number (not the display phone number)
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Meta Graph API version
WHATSAPP_API_VERSION=v21.0

# ── Shopify Admin API ─────────────────────────────────────────────────────────
# Your Shopify store domain (without https://)
SHOPIFY_STORE_DOMAIN=mystore.myshopify.com

# Admin API access token from a custom app with read_products + write_draft_orders scopes
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify Admin API version
SHOPIFY_API_VERSION=2025-01

# ── Staff Authorization ───────────────────────────────────────────────────────
# Comma-separated list of WhatsApp phone numbers allowed to use the bot.
# Use full international format without + (e.g. 5218112345678 for a MX number).
ALLOWED_STAFF_PHONES=5218112345678,12125551234

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Vercel's Storage integration injects KV-prefixed names automatically.
# For local dev, use the plain names below (copy values from Upstash console).
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
# (On Vercel these are auto-set as UPSTASH_REDIS_REST_KV_URL and UPSTASH_REDIS_REST_KV_REST_API_TOKEN)
